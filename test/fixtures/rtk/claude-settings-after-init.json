{
  "permissions": {
    "allow": [
      "Bash(git status:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/ana/.orca/agent-hooks/claude-hook.cmd || echo {}",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/ana/.orca/agent-hooks/claude-hook.cmd || echo {}",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
